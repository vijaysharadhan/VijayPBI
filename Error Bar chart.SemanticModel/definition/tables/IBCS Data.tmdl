	measure 'Red Max' = ```
			If([DeltaPY] <0, [Max value])
			    
			```
		lineageTag: 9411827c-e2db-4599-b0e9-c7d7a297c1a9

	measure 'Green Max' = ```
			If([DeltaPY]> 0, [Max value])
			    
			```
		lineageTag: d89ee756-83c8-4c3b-856f-14ca9a37be0a

	measure 'Delta Color' = ```
			IF( [DeltaPY] <0,  "#ff0000","#008e94")
			    
			```
		lineageTag: 4803d962-bf1a-4b5f-857f-4d7212a4217f

	measure 'DeltaPY %' = format(DIVIDE ( [DeltaPY], [PY] ), "0.0%" ) & " vs " & sum('IBCS Data'[2022])
		lineageTag: d38e3af9-5afe-4ea2-af2a-e94e1f7fef12

	measure 'Max value' = ```
			IF(ISBLANK([FC]), 
			  if([AC]>[PY], [AC], [PY]),
			  if([PY]>[FC], [PY], [FC]))
			    
			```
		lineageTag: dd3d4f0e-c522-4c42-bb00-eb5b36da93eb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

