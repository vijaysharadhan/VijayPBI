table 'IBCS Data'
	lineageTag: 72296fa6-f72a-4853-b3cd-3bb5d8274f9c

	measure DeltaPY = ```
			IF(ISBLANK([FC]), [AC] - [PY], [FC] - [PY])
			    
			```
